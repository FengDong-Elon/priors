# Where Priors stores derived caches (default: ~/.priors/cache)
PRIORS_CACHE_DIR=

# Sharadar (bring your own data). Point to local Parquet exports of the SEP,
# SF1 and TICKERS tables.
SHARADAR_SEP_PATH=
SHARADAR_SF1_PATH=
SHARADAR_TICKERS_PATH=

# LLM provider
ANTHROPIC_API_KEY=
# Optional overrides (defaults: anthropic, claude-haiku-4-5 for the fast tier, claude-opus-5-5 for the deep tier)
PRIORS_LLM_PROVIDER=
PRIORS_FAST_MODEL=
PRIORS_DEEP_MODEL=

# Your own Nasdaq Data Link key, for `priors sharadar-download` (downloads Sharadar to this computer only)
NASDAQ_DATA_LINK_API_KEY=
